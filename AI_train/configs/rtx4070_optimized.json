{
  "model": {
    "input_size": 15,
    "hidden_sizes": [96, 48, 24, 12],
    "output_size": 3,
    "activation": "relu",
    "dropout_rate": 0.15,
    "model_name": "network_quality_model_4070",
    "save_format": "onnx",
    "precision": "float16",
    "model_complexity": "medium"
  },
  "data": {
    "num_samples": 30000,
    "use_existing_data": true,
    "preprocess_config": {
      "test_size": 0.2,
      "validation_size": 0.1,
      "random_state": 42,
      "scale_features": true,
      "feature_engineering": true,
      "handle_outliers": true
    },
    "batch_size": 128,
    "shuffle": true,
    "data_augmentation": {
      "enabled": true,
      "noise_level": 0.01,
      "augmentation_ratio": 0.15,
      "advanced_augmentation": false
    },
    "cache_dataset": true,
    "prefetch_batches": 2
  },
  "training": {
    "learning_rate": 0.0015,
    "epochs": 200,
    "batch_size": 128,
    "early_stopping_patience": 12,
    "save_best_model": true,
    "model_save_dir": "checkpoints/4070_optimized",
    "log_interval": 10,
    "hardware_adaptive": true,
    "optimizer": "adam",
    "loss_function": "mse",
    "metrics": ["mse", "mae", "r2", "accuracy"],
    "mixed_precision": true,
    "gradient_accumulation_steps": 1,
    "warmup_steps": 500
  },
  "progressive": {
    "stages": [
      {
        "name": "warmup",
        "epochs": 30,
        "data_ratio": 0.1,
        "lr": 0.005,
        "batch_size": 256,
        "description": "预热阶段：中等批次快速收敛"
      },
      {
        "name": "main_training",
        "epochs": 100,
        "data_ratio": 0.5,
        "lr": 0.001,
        "batch_size": 128,
        "description": "主要训练：标准参数训练"
      },
      {
        "name": "fine_tuning",
        "epochs": 50,
        "data_ratio": 0.8,
        "lr": 0.0003,
        "batch_size": 64,
        "description": "精细调优：低学习率微调"
      },
      {
        "name": "final_refinement",
        "epochs": 20,
        "data_ratio": 1.0,
        "lr": 0.0001,
        "batch_size": 32,
        "description": "最终精炼：超低学习率优化"
      }
    ],
    "enable_multi_task": true,
    "task_weights": [0.4, 0.4, 0.2],
    "adaptive_scheduling": true,
    "stage_transition_threshold": 0.008,
    "dynamic_batch_sizing": true
  },
  "hardware": {
    "adaptive_training": true,
    "precision_mode": "mixed",
    "batch_size_optimization": true,
    "memory_optimization": true,
    "gpu_acceleration": true,
    "cuda_optimizations": {
      "tensor_cores": true,
      "cudnn_benchmark": true,
      "cudnn_deterministic": false,
      "memory_pinning": true
    },
    "gpu_specific": {
      "memory_gb": 12,
      "compute_capability": 8.9,
      "tensor_cores": true,
      "max_batch_size": 512,
      "recommended_batch_size": 128
    }
  },
  "monitoring": {
    "save_checkpoints": true,
    "checkpoint_interval": 10,
    "log_metrics": true,
    "performance_monitoring": true,
    "visualization": true,
    "report_generation": true,
    "gpu_utilization_monitoring": true,
    "memory_usage_tracking": true
  },
  "evaluation": {
    "test_metrics": ["mse", "mae", "r2", "accuracy", "precision", "recall"],
    "cross_validation": {
      "enabled": true,
      "folds": 5
    },
    "generalization_test": true,
    "confidence_threshold": 0.75,
    "advanced_metrics": {
      "inference_speed": true,
      "memory_usage": true
    }
  },
  "network_quality": {
    "targets": {
      "hotspot_probability": {
        "weight": 0.4,
        "description": "热点推荐概率，基于网络质量评估",
        "optimization_priority": "high"
      },
      "quality_score": {
        "weight": 0.4,
        "description": "网络质量评分，综合评估网络性能",
        "optimization_priority": "high"
      },
      "confidence": {
        "weight": 0.2,
        "description": "预测置信度，评估模型预测可靠性",
        "optimization_priority": "medium"
      }
    },
    "quality_thresholds": {
      "excellent": 0.9,
      "good": 0.75,
      "fair": 0.6,
      "poor": 0.4
    },
    "performance_targets": {
      "inference_speed_ms": 2.0,
      "accuracy_target": 0.9,
      "precision_target": 0.85,
      "recall_target": 0.8
    }
  },
  "advanced_optimizations": {
    "gradient_clipping": {
      "enabled": true,
      "max_norm": 1.5
    },
    "learning_rate_scheduling": {
      "enabled": true,
      "scheduler": "step",
      "warmup_epochs": 5,
      "min_lr": 1e-5
    },
    "regularization": {
      "l2_regularization": 0.001,
      "label_smoothing": 0.05,
      "dropout_scheduling": false
    }
  },
  "deployment": {
    "target_platforms": ["windows", "linux"],
    "optimization_level": "medium",
    "quantization": {
      "enabled": true,
      "method": "dynamic",
      "precision": "int8"
    },
    "onnx_optimizations": {
      "graph_optimization": true,
      "operator_fusion": true,
      "constant_folding": true
    }
  }
}
