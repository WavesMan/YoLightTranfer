{
  "model": {
    "input_size": 15,
    "hidden_sizes": [128, 64, 32, 16],
    "output_size": 3,
    "activation": "relu",
    "dropout_rate": 0.1,
    "model_name": "network_quality_model_4090",
    "save_format": "onnx",
    "precision": "float16",
    "model_complexity": "high"
  },
  "data": {
    "num_samples": 50000,
    "use_existing_data": true,
    "preprocess_config": {
      "test_size": 0.15,
      "validation_size": 0.15,
      "random_state": 42,
      "scale_features": true,
      "feature_engineering": true,
      "handle_outliers": true
    },
    "batch_size": 256,
    "shuffle": true,
    "data_augmentation": {
      "enabled": true,
      "noise_level": 0.005,
      "augmentation_ratio": 0.2,
      "advanced_augmentation": true
    },
    "cache_dataset": true,
    "prefetch_batches": 4
  },
  "training": {
    "learning_rate": 0.002,
    "epochs": 300,
    "batch_size": 256,
    "early_stopping_patience": 15,
    "save_best_model": true,
    "model_save_dir": "checkpoints/4090_optimized",
    "log_interval": 5,
    "hardware_adaptive": true,
    "optimizer": "adamw",
    "loss_function": "mse",
    "metrics": ["mse", "mae", "r2", "accuracy"],
    "mixed_precision": true,
    "gradient_accumulation_steps": 1,
    "warmup_steps": 1000
  },
  "progressive": {
    "stages": [
      {
        "name": "ultra_warmup",
        "epochs": 20,
        "data_ratio": 0.05,
        "lr": 0.01,
        "batch_size": 512,
        "description": "超快速预热：利用4090高算力快速收敛"
      },
      {
        "name": "high_speed",
        "epochs": 50,
        "data_ratio": 0.2,
        "lr": 0.005,
        "batch_size": 512,
        "description": "高速训练：大批次高学习率训练"
      },
      {
        "name": "main_training",
        "epochs": 100,
        "data_ratio": 0.6,
        "lr": 0.001,
        "batch_size": 256,
        "description": "主要训练：标准参数训练"
      },
      {
        "name": "fine_tuning",
        "epochs": 80,
        "data_ratio": 1.0,
        "lr": 0.0002,
        "batch_size": 128,
        "description": "精细调优：低学习率小批次微调"
      },
      {
        "name": "final_refinement",
        "epochs": 50,
        "data_ratio": 1.0,
        "lr": 0.00005,
        "batch_size": 64,
        "description": "最终精炼：超低学习率优化"
      }
    ],
    "enable_multi_task": true,
    "task_weights": [0.4, 0.4, 0.2],
    "adaptive_scheduling": true,
    "stage_transition_threshold": 0.005,
    "dynamic_batch_sizing": true
  },
  "hardware": {
    "adaptive_training": true,
    "precision_mode": "mixed",
    "batch_size_optimization": true,
    "memory_optimization": true,
    "gpu_acceleration": true,
    "cuda_optimizations": {
      "tensor_cores": true,
      "cudnn_benchmark": true,
      "cudnn_deterministic": false,
      "memory_pinning": true
    },
    "gpu_specific": {
      "memory_gb": 25,
      "compute_capability": 8.9,
      "tensor_cores": true,
      "max_batch_size": 1024,
      "recommended_batch_size": 256
    }
  },
  "monitoring": {
    "save_checkpoints": true,
    "checkpoint_interval": 5,
    "log_metrics": true,
    "performance_monitoring": true,
    "visualization": true,
    "report_generation": true,
    "gpu_utilization_monitoring": true,
    "memory_usage_tracking": true,
    "real_time_metrics": true
  },
  "evaluation": {
    "test_metrics": ["mse", "mae", "r2", "accuracy", "precision", "recall", "f1_score"],
    "cross_validation": {
      "enabled": true,
      "folds": 10
    },
    "generalization_test": true,
    "confidence_threshold": 0.8,
    "advanced_metrics": {
      "inference_speed": true,
      "memory_usage": true,
      "gpu_utilization": true
    }
  },
  "network_quality": {
    "targets": {
      "hotspot_probability": {
        "weight": 0.4,
        "description": "热点推荐概率，基于网络质量评估",
        "optimization_priority": "high"
      },
      "quality_score": {
        "weight": 0.4,
        "description": "网络质量评分，综合评估网络性能",
        "optimization_priority": "high"
      },
      "confidence": {
        "weight": 0.2,
        "description": "预测置信度，评估模型预测可靠性",
        "optimization_priority": "medium"
      }
    },
    "quality_thresholds": {
      "excellent": 0.95,
      "good": 0.85,
      "fair": 0.7,
      "poor": 0.5
    },
    "performance_targets": {
      "inference_speed_ms": 1.0,
      "accuracy_target": 0.95,
      "precision_target": 0.92,
      "recall_target": 0.90
    }
  },
  "advanced_optimizations": {
    "gradient_clipping": {
      "enabled": true,
      "max_norm": 1.0
    },
    "learning_rate_scheduling": {
      "enabled": true,
      "scheduler": "cosine_annealing",
      "warmup_epochs": 10,
      "min_lr": 1e-6
    },
    "regularization": {
      "l2_regularization": 0.001,
      "label_smoothing": 0.1,
      "dropout_scheduling": true
    },
    "ensemble_learning": {
      "enabled": true,
      "num_models": 3,
      "voting_strategy": "weighted"
    }
  },
  "deployment": {
    "target_platforms": ["windows", "linux", "docker"],
    "optimization_level": "high",
    "quantization": {
      "enabled": true,
      "method": "dynamic",
      "precision": "int8"
    },
    "onnx_optimizations": {
      "graph_optimization": true,
      "operator_fusion": true,
      "constant_folding": true
    }
  }
}
