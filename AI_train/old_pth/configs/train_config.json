{
  "project": {
    "name": "AI Network Quality Analysis",
    "version": "1.0.0",
    "author": "YoLightTransfer Team",
    "description": "AI model for network quality prediction and hotspot recommendation"
  },
  "model": {
    "input_size": 3,
    "hidden_sizes": [128, 64, 32, 16],
    "dropout_rate": 0.2,
    "use_batch_norm": true,
    "activation": "relu"
  },
  "training": {
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "batch_size": 64,
    "epochs": 100,
    "early_stopping_patience": 10,
    "validation_split": 0.2,
    "test_split": 0.1,
    "random_seed": 42,
    "optimizer": "AdamW",
    "scheduler": "ReduceLROnPlateau"
  },
  "data": {
    "data_dir": "data",
    "raw_data_dir": "data/raw",
    "processed_data_dir": "data/processed",
    "models_dir": "models",
    "checkpoint_dir": "checkpoints",
    "dataset_size": 10000,
    "scenario_weights": {
      "strong_network": 0.4,
      "weak_network": 0.3,
      "critical_network": 0.3
    },
    "data_generation": {
      "uncertainty_level": 0.7,
      "include_mixed_scenarios": true,
      "include_boundary_samples": true,
      "include_conflict_samples": true,
      "boundary_sample_ratio": 0.15,
      "conflict_sample_ratio": 0.15,
      "dynamic_uncertainty": true,
      "max_uncertainty": 0.9,
      "min_uncertainty": 0.3
    }
  },
  "evaluation": {
    "test_size": 1000,
    "metrics": ["accuracy", "precision", "recall", "f1", "auc_roc"],
    "confidence_threshold": 0.5,
    "save_predictions": true,
    "plot_results": true
  }
}
